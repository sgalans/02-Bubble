{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug (Win32)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/build.ps1",
                "-Configuration", "Debug",
                "-Platform", "Win32",
                "-Target", "Build"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Build Release (Win32)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/build.ps1",
                "-Configuration", "Release",
                "-Platform", "Win32",
                "-Target", "Build"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Clean (Win32)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/build.ps1",
                "-Configuration", "Debug",
                "-Platform", "Win32",
                "-Target", "Clean"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        }
    ]
}
